@model Role

<form method="post" class="text-center col-3">
    <div class="mb-3">
        <label>Добавить новую роль</label>
    </div>
    <div class="text-danger font-weight-bold" asp-validation-summary="All"></div>
    <div class="mb-3">
        <label asp-for="Name">Название</label>
        <input asp-for="Name" type="text" class="form-control" placeholder="Название">
        <span asp-validation-for="Name"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Добавить</button>
    </div>
</form>
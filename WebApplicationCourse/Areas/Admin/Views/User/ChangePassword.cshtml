@model User

<form method="post" class="text-center col-3">
    <div asp-validation-summary="ModelOnly" class="text-danger font-weight-bold"></div>
    <div class="mb-3">
        <label>Изменить пароль</label>
    </div>
    <div class="mb-3">
        <label asp-for="Password">Новый пароль</label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Новый пароль">
        <span asp-validation-for="Password"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword">Подтвердите новый пароль</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Подтвердите новый пароль">
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Изменить</button>
    </div>
</form>

@model List<Role>

<div class="row">
    @await Html.PartialAsync("Index")
    <div class="col-6 text-center">
        <h3>Список ролей</h3>
        <a asp-controller="Admin" asp-action="AddRole">Добавить новую роль</a>
        <table class="table">
            <thead>
                <tr>
                    <td>№</td>
                    <td>Название</td>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count(); i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model[i].Name</td>
                        <td><a asp-controller="Admin" asp-action="RemoveRole" asp-route-name="@Model[i].Name">Удалить</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>